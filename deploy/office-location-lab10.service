[Unit]
Description=Lab 10 office-location API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=exedev
Group=exedev
WorkingDirectory=/home/exedev/office-location-lab10
EnvironmentFile=-/home/exedev/office-location-lab10/.env
ExecStart=/home/exedev/office-location-lab10/.venv/bin/uvicorn app:app --host 0.0.0.0 --port 8011
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
